/* pages/index/index.wxss */
.home {
  padding: 32rpx 24rpx 60rpx;
}

.hero {
  padding: 40rpx 16rpx 32rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #2B2B2B;
}

.hero-sub {
  font-size: 26rpx;
  color: #8A8A8A;
  margin-top: 12rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2B2B;
  margin: 24rpx 8rpx 16rpx;
}

.scenes {
  display: flex;
  gap: 16rpx;
}

.scene {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.scene-active {
  border-color: #FF7043;
  background: #FFF3EE;
}

.scene-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2B2B2B;
}

.scene-desc {
  font-size: 20rpx;
  color: #8A8A8A;
  margin-top: 8rpx;
}

.inv-entry {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.inv-entry-left {
  flex: 1;
  min-width: 0;
}

.inv-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2B2B2B;
}

.inv-entry-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8A8A;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.inv-badge {
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  color: #fff;
}

.inv-badge-warn {
  background: #FB8C00;
}

.inv-badge-danger {
  background: #E53935;
}

.inv-entry-arrow {
  font-size: 48rpx;
  color: #CCC;
  margin-left: 16rpx;
}

.prefer-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.prefer-text {
  flex: 1;
  min-width: 0;
}

.prefer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2B2B;
}

.prefer-desc {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-top: 6rpx;
}

.steps-intro {
  margin-top: 32rpx;
}

.intro-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.intro-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #5A5A5A;
  padding: 10rpx 0;
}

.intro-num {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #FF7043;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.footer {
  margin-top: 48rpx;
}

.recommend-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
}

.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: #8A8A8A;
  margin-top: 20rpx;
}
