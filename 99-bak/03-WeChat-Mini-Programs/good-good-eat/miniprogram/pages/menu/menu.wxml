<!-- pages/menu/menu.wxml -->
<view class="menu-page">
  <view class="reason-card card">
    <view class="reason-head">
      <text class="reason-badge">{{source === 'ai' ? 'AI 搭配' : '智能搭配'}}</text>
      <text class="reason-swap" bindtap="onSwap">🔄 换一换</text>
    </view>
    <view class="reason-text" wx:if="{{reason}}">{{reason}}</view>
    <view class="reason-tip">点菜进入备菜清单；点右上角 ☆ 收藏常做的菜</view>
  </view>

  <view class="dish-list">
    <recipe-card
      wx:for="{{items}}"
      wx:key="_id"
      recipe="{{item}}"
      selectable="{{true}}"
      favorited="{{favSet[item._id] ? true : false}}"
      bind:favorite="onToggleFavorite"
      bind:tap="onPickDish"
    />
  </view>

  <view class="menu-footer">
    <button class="btn-ghost footer-single" bindtap="onBack">重新选场景</button>
  </view>
</view>
