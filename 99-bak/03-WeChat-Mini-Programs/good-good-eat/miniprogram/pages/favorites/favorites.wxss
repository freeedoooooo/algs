/* pages/favorites/favorites.wxss */
.fav-page {
  min-height: 100vh;
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: #F7F8FA;
}

.fav-header {
  margin-bottom: 28rpx;
}
.fav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}
.fav-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

/* 空状态 */
.fav-empty {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fav-empty-icon {
  font-size: 96rpx;
}
.fav-empty-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #555;
}
.fav-empty-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 0 40rpx;
}

/* 列表 */
.fav-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.fc-main {
  display: flex;
  flex-direction: column;
}
.fc-line1 {
  display: flex;
  align-items: center;
}
.fc-type {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.fc-meat { color: #E53935; background: #FDECEA; }
.fc-vegetable { color: #2E7D32; background: #E9F6EA; }
.fc-soup { color: #FB8C00; background: #FFF3E0; }
.fc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.fc-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.fc-time {
  font-size: 24rpx;
  color: #888;
  margin-right: 20rpx;
}
.fc-tip {
  font-size: 24rpx;
  color: #999;
}

/* 操作区 */
.fc-actions {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.fc-open {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E88E5;
  padding: 8rpx 28rpx;
  border: 1rpx solid #1E88E5;
  border-radius: 999rpx;
  margin-right: 20rpx;
}
.fc-del {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 12rpx;
}
