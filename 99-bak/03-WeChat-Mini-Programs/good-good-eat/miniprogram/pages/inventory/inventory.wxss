/* pages/inventory/inventory.wxss */
.inv-page {
  padding: 24rpx 24rpx 160rpx;
}

.inv-head {
  padding: 28rpx;
}

.inv-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.inv-summary {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sum-item {
  font-size: 28rpx;
  color: #666;
}

.badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.badge-warn {
  background: #FB8C00;
}

.badge-danger {
  background: #E53935;
}

.inv-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.inv-section {
  margin-top: 28rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.ing-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.ing-main {
  flex: 1;
  min-width: 0;
}

.ing-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.ing-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.ing-right {
  text-align: right;
  margin-left: 20rpx;
}

.ing-qty {
  font-size: 30rpx;
  font-weight: 600;
  color: #444;
}

.ing-status {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.inv-empty {
  margin-top: 40rpx;
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

.inv-fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 60rpx;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 112, 67, 0.4);
}

/* 表单弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
}

.sheet-close {
  font-size: 34rpx;
  color: #999;
  padding: 0 8rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-row {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
}

.field-col {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.field-input,
.field-picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #222;
}

.field-picker {
  color: #333;
}

.field-clear {
  font-size: 26rpx;
  color: var(--brand);
  padding: 0 8rpx 24rpx;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.sheet-del {
  flex: 1;
  height: 88rpx;
  color: #E53935;
  border-color: #E53935;
}

.sheet-save {
  flex: 2;
  height: 88rpx;
}
