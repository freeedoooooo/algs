<!-- components/checklist-item/checklist-item.wxml -->
<view class="ci {{checked ? 'ci-checked' : ''}}" bindtap="onToggle">
  <view class="ci-box">
    <text wx:if="{{checked}}" class="ci-tick">✓</text>
  </view>
  <text class="ci-text">{{text}}</text>
  <block wx:if="{{showStock}}">
    <text class="ci-badge ci-expiring" wx:if="{{expiring}}">临期</text>
    <text class="ci-badge ci-have" wx:elif="{{have}}">库存</text>
    <text class="ci-badge ci-buy" wx:else>需买</text>
  </block>
</view>
