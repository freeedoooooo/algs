<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '54px 60px 44px 60px', flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 40, height: 40, borderRadius: 20, background: '#1A3358', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
      </Box>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1A3358' }}>算法没变，老配置第一次真正可复用</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#234B80', fontWeight: 'bold' }}>资产沉淀</Text>
  </Box>
  <Box style={{ height: 1, background: '#D3DBE5', marginTop: 12 }} />

  <Box style={{ marginTop: 18, background: '#EAF0F7', borderRadius: 8, padding: '12px 20px' }}>
    <Text style={{ fontSize: 19, color: '#26282E', lineHeight: 1.5 }}>
      抽取<span style={{ color: '#234B80', fontWeight: 'bold' }}>算法没有变</span>，用的还是原来那套；复用的是长期积累的大量配置。<span style={{ color: '#234B80', fontWeight: 'bold' }}>改进的是设计</span>——让这批核心资产第一次真正可复用、可沉淀。
    </Text>
  </Box>

  <Box style={{ marginTop: 18, height: 220, borderRadius: 12, background: '#F7F9FC', padding: '14px 20px', flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
    <svg width={1110} height={190} viewBox='0 0 1110 190'>
      <defs>
        <marker id='ar' markerWidth='10' markerHeight='10' refX='8' refY='3' orient='auto'>
          <path d='M0,0 L0,6 L8,3 z' fill='#234B80' />
        </marker>
      </defs>
      <rect x='20' y='48' width='255' height='94' rx='10' fill='#5F6670' />
      <text x='147' y='88' fontFamily='Microsoft YaHei' fontSize='19' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>既有抽取配置</text>
      <text x='147' y='114' fontFamily='Microsoft YaHei' fontSize='13' fill='#D8D8D8' textAnchor='middle'>算法不变 · 大量积累</text>

      <rect x='340' y='48' width='255' height='94' rx='10' fill='#234B80' />
      <text x='467' y='88' fontFamily='Microsoft YaHei' fontSize='19' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>改进设计</text>
      <text x='467' y='114' fontFamily='Microsoft YaHei' fontSize='13' fill='#D3E0EF' textAnchor='middle'>标准结构 · 可移植</text>

      <rect x='660' y='48' width='215' height='94' rx='10' fill='#4A73A8' />
      <text x='767' y='88' fontFamily='Microsoft YaHei' fontSize='19' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>真正可复用资产</text>
      <text x='767' y='114' fontFamily='Microsoft YaHei' fontSize='13' fill='#E4ECF6' textAnchor='middle'>一次配置 · 多处受益</text>

      <rect x='940' y='48' width='150' height='94' rx='10' fill='#1A3358' />
      <text x='1015' y='88' fontFamily='Microsoft YaHei' fontSize='19' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>公司资产</text>
      <text x='1015' y='114' fontFamily='Microsoft YaHei' fontSize='13' fill='#C9D6E5' textAnchor='middle'>持续沉淀</text>

      <line x1='277' y1='95' x2='336' y2='95' stroke='#234B80' strokeWidth='2.5' markerEnd='url(#ar)' />
      <line x1='597' y1='95' x2='656' y2='95' stroke='#234B80' strokeWidth='2.5' markerEnd='url(#ar)' />
      <line x1='877' y1='95' x2='936' y2='95' stroke='#4A73A8' strokeWidth='2.5' markerEnd='url(#ar)' />

      <text x='147' y='170' fontFamily='Microsoft YaHei' fontSize='13' fill='#5F6670' textAnchor='middle'>散在各项目</text>
      <text x='467' y='170' fontFamily='Microsoft YaHei' fontSize='13' fill='#4A73A8' textAnchor='middle'>配置与平台解耦</text>
      <text x='767' y='170' fontFamily='Microsoft YaHei' fontSize='13' fill='#4A73A8' textAnchor='middle'>跨项目 / 跨平台</text>
      <text x='1015' y='170' fontFamily='Microsoft YaHei' fontSize='13' fill='#4A73A8' textAnchor='middle'>越用越值钱</text>
    </svg>
  </Box>

  <Box style={{ marginTop: 18, flexDirection: 'row', gap: 18 }}>
    <Box style={{ flex: 1, background: '#F4F7FB', borderRadius: 10, padding: '16px 18px' }}>
      <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#234B80' }}>同平台复用</Text>
      <Text style={{ marginTop: 6, fontSize: 16, color: '#3A404A', lineHeight: 1.5 }}>新项目直接沿用，配置不必重来。</Text>
    </Box>
    <Box style={{ flex: 1, background: '#F4F7FB', borderRadius: 10, padding: '16px 18px' }}>
      <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#234B80' }}>跨平台移植</Text>
      <Text style={{ marginTop: 6, fontSize: 16, color: '#3A404A', lineHeight: 1.5 }}>换系统、换平台，抽取能力随之带走。</Text>
    </Box>
    <Box style={{ flex: 1, background: '#F4F7FB', borderRadius: 10, padding: '16px 18px' }}>
      <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#234B80' }}>持续沉淀</Text>
      <Text style={{ marginTop: 6, fontSize: 16, color: '#3A404A', lineHeight: 1.5 }}>新场景反哺资产，经验越用越厚。</Text>
    </Box>
  </Box>

  <Box style={{ marginTop: 16, background: '#1A3358', borderRadius: 8, padding: '11px 18px' }}>
    <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>所以呢：不是重做算法，而是让老资产在新设计下真正可复用起来。</Text>
  </Box>
  <Box style={{ flexDirection: 'row', justifyContent: 'space-between', marginTop: 8 }}>
    <Text style={{ fontSize: 14, color: '#8C929A' }}>C1-结构化产品升级</Text>
    <Text style={{ fontSize: 14, color: '#8C929A' }}>06</Text>
  </Box>
</Slide>
