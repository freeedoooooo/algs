# 微服务环境参数
SPRING_PROFILES_ACTIVE=jianshe-pro

# 认证服务端地址配置
DIB_OAUTH_SERVER_HOST=http://58.0.94.16:8090/sso
DIB_OAUTH_SERVER_HOST_INNER=http://58.0.94.16:8090/sso

# 认证客户端回调主机，对应 nginx 端口
DIB_OAUTH_CLIENT_HOST=http://58.0.94.16:8090

# ocr服务地址
OCR_SERVER=http://58.0.94.16:8090/api-ocr/

# smartos配置
DIB_CONVERTER_SMART_ENABLED=true
DIB_CONVERTER_PROXY_URL=http://58.0.94.16:8080
DIB_CONVERTER_SMART_FORCE_EXTRACT_ENABLED=false

# 异步提取线程数
DIB_EXTRACT_THREAD_COUNT=1

# ============================================
# 数据库配置 - 支持 MySQL 和 OpenGauss 切换
# ============================================

# --- MySQL 配置（参考 application-jianshe-pro.yml）---
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql8:3306/dib_report_copilot?characterEncoding=utf8&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&useSSL=false&zeroDateTimeBehavior=convertToNull
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=Dib@12345*

# --- OpenGauss 配置（兼容 PostgreSQL，测试环境）---
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.opengauss.Driver
SPRING_DATASOURCE_URL=jdbc:opengauss://58.0.94.16:5432/c1?currentSchema=dib_report_copilot&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=gaussdb
SPRING_DATASOURCE_PASSWORD=Dib@123456

# swagger
SPRINGDOC_SWAGGER_UI_ENABLED=false
SPRINGDOC_API_DOCS_ENABLED=false

KNIFE4J_ENABLE=false
KNIFE4J_PRODUCTION=true


# 不暴露任何 Web 端点（最彻底）
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=
