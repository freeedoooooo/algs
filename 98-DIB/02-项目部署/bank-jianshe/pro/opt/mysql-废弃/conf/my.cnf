[mysqld]
# 基本设置
user = mysql
# 兼容旧系统
mysql_native_password=ON
#8.4不支持默认密码插件 mysql_native_password
#mysql_native_password = mysql_native_password
#authentication_policy = caching_sha2_password, mysql_native_password
# 客户端连接配置
socket = /var/run/mysqld/mysqld.sock
# 允许远程访问
bind-address = 0.0.0.0 

default-storage-engine = InnoDB
datadir = /var/lib/mysql
socket = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid

# 忽略表名大小写
lower_case_table_names = 1

# 字符集设置
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# 连接设置
max_connections = 200          # 最大连接数
connect_timeout = 10           # 连接超时时间（秒）
wait_timeout = 600             # 非交互连接超时（秒）
interactive_timeout = 1800     # 交互连接超时（秒）

# 日志设置
log_error = /var/log/mysql/error.log
slow_query_log = 1            # 开启慢查询日志
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2           # 慢查询阈值（秒）
log_queries_not_using_indexes = 1  # 记录未使用索引的查询

# InnoDB优化
innodb_buffer_pool_size = 4G  # InnoDB缓冲池大小
innodb_log_file_size = 512M   # 重做日志文件大小
innodb_flush_log_at_trx_commit = 1  # 事务提交时立即写入日志
innodb_file_per_table = 1      # 每个表单独表空间文件
innodb_lock_wait_timeout = 50  # 锁等待超时时间（秒）

# 临时表优化
tmp_table_size = 64M          # 内存临时表大小
max_heap_table_size = 64M     # 堆内存表大小

# 其他优化
skip-name-resolve              # 禁用DNS解析
performance_schema = ON        # 开启性能监控

[client]
socket = /var/run/mysqld/mysqld.sock  # 客户端Socket路径
