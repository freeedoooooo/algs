# ============================================================
# Kuboard v4 环境变量配置
# ============================================================
# 复制本文件为 .env 并修改以下参数
# cp .env.example .env
# ============================================================

# MariaDB root 密码
KUBOARD_ROOT_PASSWORD=kuboardpwd

# Kuboard 数据库用户密码
KUBOARD_DB_PASSWORD=kuboardpwd

# Kuboard Web 访问端口（宿主机端口）
KUBOARD_PORT=38000
